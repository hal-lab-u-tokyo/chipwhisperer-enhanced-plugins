# SAKURA-X Shell with the sakura-x-shell.xml EEPROM configuration.
# USB properties are populated by the standard 60-serial.rules / usb_id.
# Match the USB device attributes together; the interface number comes from
# ENV because it belongs to a different parent in the sysfs hierarchy.
# Channel A (00): FIFO data; Channel B (01): reserved for reset control.
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyUSB[0-9]*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6010", ATTRS{product}=="SAKURA-X Shell", ENV{ID_SERIAL_SHORT}=="?*", ENV{ID_USB_INTERFACE_NUM}=="00", MODE="0666", SYMLINK+="sakura-x-shell/$env{ID_SERIAL_SHORT}/data"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyUSB[0-9]*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6010", ATTRS{product}=="SAKURA-X Shell", ENV{ID_SERIAL_SHORT}=="?*", ENV{ID_USB_INTERFACE_NUM}=="01", MODE="0666", SYMLINK+="sakura-x-shell/$env{ID_SERIAL_SHORT}/reset"
